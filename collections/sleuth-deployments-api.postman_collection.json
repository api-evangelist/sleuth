              "mode": "raw",
              "raw": "{\n  \"sha\": \"<string>\",\n  \"environment\": \"<string>\",\n  \"date\": \"<string>\",\n  \"branch\": \"<string>\",\n  \"tags\": \"<string>\",\n  \"ignore_if_duplicate\": \"<string>\",\n  \"email\": \"<string>\",\n  \"links\": \"<string>\",\n  \"commits\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"files\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"pull_requests\": [\n    \"<object>\",\n    \"<object>\"\n  ]\n}",
