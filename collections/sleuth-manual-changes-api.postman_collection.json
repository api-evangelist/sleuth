  "info": {
    "_postman_id": "fb3c748e-21d1-466d-8899-b5e4b6fb601e",
    "name": "Sleuth Deployment & Impact Registration Deployments Manual Changes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Sleuth registration API is a REST API used to push software delivery events into Sleuth so it can compute DORA metrics (deploy frequency, lead time, change failure rate, and time to restore). It covers code deploy registration, free-form manual change registration, custom metric impact values, and custom incident impact events. Sleuth's broader public API is a GraphQL surface at https://app.sleuth.io/graphql. Requests authenticate with an organization or scoped Access Token API key.\n\nContact Support:\n Name: Sleuth Support\n Email: support@sleuth.io",
      "type": "text/plain"
    }
  }
